# ---- REQUIRED ----
# MongoDB Atlas connection string.
# NOTE: this file is a TEMPLATE and IS committed to git. Never put real
# credentials here — put them in .env.local, which is gitignored.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/alcove_crm?retryWrites=true&w=majority"

# Secret used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-string"

# Public base URL of the deployed app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- SEED (only used by: npm run seed) ----
SEED_ORG_NAME="Royal UPVC Doors & Windows"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe@12345"
